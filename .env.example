# Set this to the exact public URL submitted to the grader, including /a2a/
A2A_BASE_URL=https://YOUR-DOMAIN/a2a/
# Use a long random secret; comma-separated tokens are supported for isolated users
A2A_BEARER_TOKENS=replace-with-long-random-secret
# Any OpenAI-compatible provider/model can be configured
OPENAI_API_KEY=your-provider-api-key
AI_MODEL=gpt-4o-mini
# Optional for OpenAI-compatible providers
# OPENAI_BASE_URL=https://api.provider.example/v1
# Persist this path on a mounted disk in production
DATABASE_PATH=./data/invoice_agent.sqlite3
